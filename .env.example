# ============================================================================
# PROJECTVAULT ENVIRONMENT CONFIGURATION
# ============================================================================

# 1. Supabase PostgreSQL & Auth Credentials
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# 2. GitHub REST API Integration (Server-Side Secrets)
# Never expose GITHUB_TOKEN to the client side.
# Create a Personal Access Token (classic or fine-grained) with `repo` permissions.
GITHUB_TOKEN=""
GITHUB_OWNER="hrishabh1103"
GITHUB_REPO="my-live-projects"
GITHUB_BRANCH="main"

# 3. Cloudflare Deployment (Optional for local CLI deployment)
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ACCOUNT_ID=""

